{
  "_comment": [
    "Copy to cohort_config.json (gitignored) and edit. Every key is optional; defaults are in build_viewer.py DEFAULTS.",
    "Unit ids, core annotation and clinical fields are study data: they live in your input tables, never in this file's tracked copy."
  ],
  "title": "CosMx TMA viewer",
  "file_prefix": "viewer_",
  "pixel_size_um": 0.12028,
  "fov_size_px": 4256,
  "layout": {"ncol": 3, "slot_um": 1760, "cell_margin_um": 20, "align_rows": [["CORE_ID_1", "CORE_ID_2"]]},
  "morphology": {"overview_px_per_um": 0.5, "overview_jpeg_quality": 88, "hires_px_per_um": 4.0, "hires_jpeg_quality": 85},
  "levels": ["Cell type · L1", "Cell type · L2", "Cell type · L3"],
  "hidden_default": ["LowQuality"],
  "palette": {"Epithelial": "#e6194B", "Stromal": "#9A6324", "Immune": "#4363d8", "Endothelial": "#3cb44b", "LowQuality": "#c8c8c8"},
  "channels": {"PanCK": "mean_panck", "CD45": "mean_cd45", "DAPI": "mean_dapi", "Membrane": "mean_membrane"},
  "core_groups": {"group_a": {"label": "Group A", "short": "A", "color": "#00C2FF"},
                  "group_b": {"label": "Group B", "short": "B", "color": "#FF5A5A"}},
  "core_group_title": "Group",
  "core_short_fields": ["annotation"],
  "core_tooltip_fields": [{"label": "Annotation", "field": "annotation"}],
  "core_summary_fields": [{"label": "Annotation", "field": "annotation"}],
  "patient_fields": [{"label": "Field 1", "field": "field_1"}, {"label": "Field 2", "field": "field_2", "format": "{:.1f}"}],
  "patient_warn": {"Field 1": "^flag-value$"},
  "patient_summary_after": "Field 1",
  "storage_prefix": "tmaviewer",
  "he": {"max_px": 850, "default_pose": {"angle": 0, "flip": 1, "fy": 1}, "pose_rules": [{"prefix": "SLIDE2_", "pose": {"angle": 270}}]},
  "region": {"label": "Region", "toggle": "Important region", "note": "",
             "tiers": {"1": {"text": "Tier 1 description"}, "2": {"text": "Tier 2 description"}, "3": {"text": "Tier 3 description", "col": "#ff9f1c"}},
             "info_fields": [{"label": "Summary", "field": "summary"}]},
  "left_default": "__rawimg__",
  "right_default": "__he__",
  "index": {"title": "CosMx TMA viewers", "subtitle": ""}
}
