#!/bin/bash
# =============================================================================
# CGC morphology stitch — SLURM array (one task per (patient,slide) unit)
# =============================================================================
# Each array task stitches ONE unit's CellComposite FOVs into a flipud-corrected
# global-micron mosaic and writes rawimg_<unit_id>.json to the build dir.
# Resources: 2 CPU / 8 GB / 20 min per task -- matched to a ~40-FOV LANCZOS
#   downscale-to-2500px stitch (single-threaded PIL; 8 GB covers <unit>'s 199-FOV
#   unit at 4256x4256 tiles). No --partition / --account (cluster defaults, as
#   the validated run_mosaic.sbatch used).
#
# Usage:
#   cd <BUILD_DIR>                       # holds units.txt, viewer_units.tsv,
#   sbatch --array=1-$(wc -l < units.txt) stitch_morphology.sbatch   # stitch_one.py
#   # one unit (test):   sbatch --array=<line-number> stitch_morphology.sbatch
# units.txt = one unit_id per line (generated by run_all.sh from viewer_units.tsv)
# =============================================================================
#SBATCH --job-name=cgc_stitch
#SBATCH --array=1-2
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=00:40:00
#SBATCH --output=cgc_stitch_%A_%a.log
set -euo pipefail

BUILD_DIR="${BUILD_DIR:-$(pwd)}"
PY=<hpc_project_root>/mamba/envs/GenomicTools/bin/python
UNIT=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "${BUILD_DIR}/units.txt")

echo "[task ${SLURM_ARRAY_TASK_ID}] unit=${UNIT}  host=$(hostname)  $(date)"
if [[ -z "${UNIT}" ]]; then echo "no unit at line ${SLURM_ARRAY_TASK_ID}"; exit 0; fi

$PY "${BUILD_DIR}/stitch_one.py" "${UNIT}" \
    --units "${BUILD_DIR}/viewer_units.tsv" \
    --out   "${BUILD_DIR}"
echo "[task ${SLURM_ARRAY_TASK_ID}] done  $(date)"
